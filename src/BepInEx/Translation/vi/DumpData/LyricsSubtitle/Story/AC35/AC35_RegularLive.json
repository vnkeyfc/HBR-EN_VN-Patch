      "EndSecond": 67.3,
      "OriginalText": "In this rain",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 9,
      "Enabled": true,
      "StartSecond": 67.4,
      "EndSecond": 72.2,
      "OriginalText": "There we played kick-the-can, keep on going on",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 10,
      "Enabled": true,
      "StartSecond": 72.3,
      "EndSecond": 77.6,
      "OriginalText": "I liked you, I loved you, always will",

      "Enabled": true,
      "StartSecond": 24.8,
      "EndSecond": 32.3,
      "OriginalText": "Say to me you'll be there",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 3,
      "Enabled": true,
      "StartSecond": 35,
      "EndSecond": 48.2,
      "OriginalText": "Here comes the winter, let me be like a tardigrade, curling up",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 4,
      "Enabled": true,
      "StartSecond": 50.8,
      "EndSecond": 55.5,
      "OriginalText": "I will go exist until the end of the universe!",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 5,
      "Enabled": true,
      "StartSecond": 56.8,
      "EndSecond": 62.1,
      "OriginalText": "Memories, chasing planes, white streaks through the sky",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 6,
      "Enabled": true,
      "StartSecond": 62.2,
      "EndSecond": 64.6,
      "OriginalText": "Will your shape blur and fade?",

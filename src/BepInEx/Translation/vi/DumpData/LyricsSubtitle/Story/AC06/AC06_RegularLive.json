      "OriginalText": "Baby You Let You Go Only Tonight!",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 1,
      "Enabled": true,
      "StartSecond": 5.3,
      "EndSecond": 14.2,
      "OriginalText": "Wow Wow Wow Wow...",

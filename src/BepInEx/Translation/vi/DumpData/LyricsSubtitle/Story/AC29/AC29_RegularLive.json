    {
      "Index": 4,
      "Enabled": true,
      "StartSecond": 34.5,
      "EndSecond": 37.2,
      "OriginalText": "But the time flies by",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 5,
      "Enabled": true,
      "StartSecond": 37.3,
      "EndSecond": 42.9,
      "OriginalText": "Can we forever be passing our time carefree",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 6,
      "Enabled": true,
      "StartSecond": 43,
      "EndSecond": 52.5,
      "OriginalText": "The way that we are now, I'm not really sure if we'll get to",
      "Text": "",
      "Style": {}
    },
    {
      "Index": 7,
      "Enabled": true,
      "StartSecond": 54,
      "EndSecond": 59.1,
      "OriginalText": "Lightning came splitting, down through the darkness",

    {
      "Key": "VC_DC01_v003_00417_NNanase",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Projection complete. I have a lock on the target.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_Z_906100126_RKayamori",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Nice job, Nanamin!!!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_DC01_v003_00422_RKayamori",
      "Context": "Adv.playCutIn:3",
      "Original": "Let's go, girls! Don't let this chance slip away!",
      "Vietnamese": ""
    },

    },
    {
      "Key": "VC_ActivityAtMiemie_00018_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "This is AMAZING!!!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtMiemie_00019_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Awww yesss! The bubbles are relaxing the sore spots in my muscles.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtMiemie_00020_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(It's like getting a full body massage...)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtMiemie_00021_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Good for shy people too, since the bubbles hide everything!)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtMiemie_00022_RKayamori",
      "Context": "Adv.kayamoriTalk:0",

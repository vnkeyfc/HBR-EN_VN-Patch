    {
      "Key": "VC_ActivityAtLibrary_00000_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(I'm at the Library, but what should I do?)",
      "Vietnamese": ""
    },
    {
      "Context": "Field.isItPossibleActivity:0",
      "Original": "Hang out at the library today?",
      "Vietnamese": ""
    },
    {
      "Context": "Field.isItPossibleActivity:1",
      "Original": "Hang out",
      "Vietnamese": ""
    },
    {
      "Context": "Field.isItPossibleActivity:2",
      "Original": "Leave",
      "Vietnamese": ""
    },
    {
      "Context": "Field.isItPossibleActivity:3",
      "Original": "Spend time at the Library to raise your Openness.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00001_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Well, what should I read?)",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:0",
      "Original": "Read what?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:1",
      "Original": "A pet magazine|A history book|A philosophy book",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00002_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Who's printing magazines in this chaos? The military? I guess it has to be the military!)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00003_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(It's a pet magazine, too... Who can even own a cat or dog nowadays?! But the pictures are so cute! Agh, this is torture!)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00004_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(It's kind of strange...)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00005_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(But I guess this magazine lets people experience the feeling of owning a pet...or something.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00006_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Hmm...that was really stress-relieving.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00007_Byakko",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Rawrrr...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00008_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Huh? Why's there a tiger in the library?!)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00009_EAoi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "This is nostalgic isn't it, Byakko? It's a picture from when you were a little kitten.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00010_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Oh, they're looking at the pet magazine! I guess that kitty was actually a baby tiger!)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00007_Byakko#2",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Rawrrr...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00012_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(A pretty girl and a tiger, reading a magazine together...what an odd but cute sight.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_ActivityAtLibrary_00013_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Byakko's in the library?!)",

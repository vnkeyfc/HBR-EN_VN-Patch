    {
      "Key": "VC_AC42_00509_CReaper",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Roger that. Give us a call if anythin' happens.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_AC42_00510_LShanhua",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We did not encounter any Cancers on the way here, but let us perfect our coordination today!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_Z_906800035_CSkopovskaya",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Ruka approves... I am now very motivated.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_Z_906800036_MdAngelis",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Time to make up for yesterday's blunder.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_Z_906800037_IRedmayne",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I've got the image training down perfectly! Let's go.",

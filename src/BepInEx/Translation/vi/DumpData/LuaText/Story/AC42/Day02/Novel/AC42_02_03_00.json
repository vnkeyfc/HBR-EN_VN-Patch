    {
      "Key": "VC_AC42_00511_VBalakrishnan",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Everyone... You look incredibly motivated.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_Z_906800038_CReaper",
      "Context": "Adv.talkWithFacial:3",
      "Original": "'Course we are! 31-X's a unit of elites gathered from all across the globe. We're not gonna let this failure stand.",

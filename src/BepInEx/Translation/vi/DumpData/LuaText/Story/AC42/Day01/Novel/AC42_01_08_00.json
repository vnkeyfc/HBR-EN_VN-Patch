    },
    {
      "Key": "VC_AC42_00310_LShanhua",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I cannot afford to let my dignity as a tactician falter... I shall go to the arena.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_AC42_00311_VBalakrishnan",
      "Context": "Adv.talkWithFacialInMonolog:3",
      "Original": "(If I define everyone's hunger as <i>h</i>, and their irritation value as <i>i</i>...)",

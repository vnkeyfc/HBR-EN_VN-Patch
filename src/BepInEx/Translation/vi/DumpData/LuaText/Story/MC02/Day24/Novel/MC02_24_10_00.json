{
  "Script": "Story/MC02/Day24/Novel/MC02_24_10_00",
  "Entries": [
    {
      "Key": "VC_MC02_24_10_00_Novel_00000_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "Ruka Kayamori from 31-A, do you copy?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00001_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yes, ma'am, this is Ruka Kayamori. Are we done resting now?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00002_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "Yes, you are.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00003_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Whaaat.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00004_STezuka",
      "Context": "Adv.showMiniCutIn:2",
      "Original": "We're in the middle of an operation. Stay focused.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00005_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "The plan was altered slightly to account for the delay, but we're still within target. We'll now proceed to Phase Five.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00006_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "At last...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00007_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "31-A and 31-B, head to Point Beta at Nanohana View Terrace.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00008_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Got it.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00009_STezuka",
      "Context": "Adv.showMiniCutIn:2",
      "Original": "30-G will guard the bridgehead directly.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00010_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "Your squads' mission is to scout and patrol the target area until the bridgehead setup is complete.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00011_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Understood. How long should we be out and about?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00012_STezuka",
      "Context": "Adv.showMiniCutIn:2",
      "Original": "The bridgehead will take a while to be installed, so continue until it's finished.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00013_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "Be sure to give us a report once you reach Nanohana View Terrace. Over.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_10_00_Novel_00014_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Hmm... Well, that didn't really tell us how long it'd be, but I guess we should start moving.",
      "Vietnamese": ""
    },
    {
      "Context": "Transition.setOutdoor:0",
      "Original": "Point Delta",
      "Vietnamese": ""
    },
    {
      "Context": "Transition.setOutdoor:1",
      "Original": "Nanohana View Terrace",
      "Vietnamese": ""
    }
  ],

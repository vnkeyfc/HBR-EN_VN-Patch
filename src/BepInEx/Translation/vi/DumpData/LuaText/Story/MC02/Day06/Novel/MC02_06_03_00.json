{
  "Script": "Story/MC02/Day06/Novel/MC02_06_03_00",
  "Entries": [
    {
      "Key": "VC_MC02_06_03_00_Novel_00000_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "A variety of nutrients can be found in food. This includes the three macronutrients: carbohydrates, fats, and protein.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00001_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "These macronutrients are multifunctional. Carbohydrates and fats energize muscles and the brain, with fats especially fueling the body's natural steroid hormones.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00002_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Kayamori, can you tell me what function protein molecules serve?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:0",
      "Original": "What role does protein serve?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:1",
      "Original": "It's the building block of music|It's the building block of the body|It's the building block of the mind",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00003_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's the building block of the body.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00004_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's correct.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00005_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Woo-hoo!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00006_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's the building block of the mind.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00007_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's incorrect.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00008_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It is the building block of the body.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00009_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Whaaat.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00010_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's the building block of music.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00011_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's incorrect.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00012_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It is the building block of the body.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00013_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "In other words, the building block of music! Without bodies, there'd be no music!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00014_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No music, but also no life in the first place.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00015_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Protein helps build everything from the body's muscles to its bones and skin.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00016_MAsami",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Japanese cuisine is traditionally high in carbohydrates but low in protein. When you work out, it may be worth drinking a protein shake to help build muscle.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_06_03_00_Novel_00017_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Ohh. Interesting.",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
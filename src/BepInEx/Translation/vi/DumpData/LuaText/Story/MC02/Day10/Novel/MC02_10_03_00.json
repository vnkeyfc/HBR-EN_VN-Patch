    {
      "Key": "VC_MC02_10_03_00_Novel_00006_STezuka",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Any tears or frays on your uniform are marks of shame for the Seraph Squadron. You must care for your attire accordingly.",

{
  "Script": "Story/MC02/Day23/Novel/MC02_23_11_02",
  "Entries": [
    {
      "Key": "VC_MC02_23_10_02_Novel_00000_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I've got a bad feeling about this!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00001_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "There's a strange smell in the air, too...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00002_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Hey, let's do Round Two of \"Buy the Coolest Thing\"! Whoever gets the coolest, craziest thing wins!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00003_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Didn't I say we're never doing it again?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00004_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okay, let's do Round One of Buy the Squickiest Thing! Whoever gets the grossest, squickiest thing wins!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00005_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Oh god, that's even worse.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00006_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You're the one who said we can't do Round Two, so I changed it just for you.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00007_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Round Two of the cool one is miles better...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_00997_v001_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then let's start Round Two of \"Buy the Coolest Thing\"! May the coolest and craziest win!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00008_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I ain't losin' this time around!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00009_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Let's go get 'em!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00010_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "This win's mine!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00011_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We'll see about that!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00012_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "If only you could muster this kind of team work in training.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00013_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Get set... Go!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00014_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Looks like we've got a pair of weirdos on our hands again...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00015_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No need to rush! We'll just do it like last time and present our hauls in the order of who came back first.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00016_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then, I'll go first!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00017_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Come right up, Cappy. Show us what'cha got.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00018_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's a Dragon's Breath chili pepper!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00019_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Woah, that sounds awesome! Let's try it!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00020_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You might die, but...good luck.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00021_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Whaaat? Don't say stuff like that!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00022_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It IS used in anti-riot pepper sprays, so it's quite potent!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00023_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Dang, that's pretty crazy! Who's next?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00024_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Me.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00025_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okie-dokie, Karerin. Show us the goods!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00026_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Here it is.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00027_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Is...is this...meat?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00028_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's a chicken. Or...was a chicken.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00029_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Oh nooo!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00030_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "They had a butcher service that processes the meat on the spot.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00031_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's pretty crazy too! Okay, who's up next?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00032_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That would be me...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00033_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okay, Tsukassie. Share your haul!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00034_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Here.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00035_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "What's this? A snack?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00036_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Oh, it's a spotted d**k!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00037_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "A spotted...what? Did you really just say that? Can we say that?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00038_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "A British snack this time, huh? How nice.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00039_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okay, who's next?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00040_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That'd be me.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00041_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yukkie, huh? Better brace myself... Show it to me!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00042_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "This.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00043_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "An egg?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00044_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's an egg with two yolks. Apparently.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00045_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's crazy if true! Let's break it open.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00046_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yeah...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00047_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Amazing! It really does have two yolks!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00048_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Now that's what ya call a lucky egg.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00049_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "So Yukkie's got luck on her side. We've got some stiff competition.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00050_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Who's next?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00051_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Take a gander at this.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00052_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Oh, Megumin. Bring out the goods!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00053_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's right in front of ya.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00054_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's a doll of the Kuidaore dude!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00055_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yeah.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00056_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Is it the real thing?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00057_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No clue. Just caught my eye, so I grabbed it. Kinda heavy though, so I'm leavin' it here.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00058_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then don't buy it in the first place...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00059_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okay, last up is me!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00060_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yeah, we've already seen it. When you came back with that thing, everyone started getting ready to call their Seraphim in a hurry.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00061_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Aww, no need to be so alarmed! It's just a harmless, life-sized replica of a Cancer!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00062_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You know full well we're training to defeat those things, right? Of course we're going to react.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00063_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I guess if everyone was that surprised, mine is the winner?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00064_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No doubt about it.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00065_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yesss! That's two wins in a row for me!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00066_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That was so fun! We should definitely play that again sometime, yeah?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_23_10_02_Novel_00067_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I said it once, and I'll say it again. Over my dead body.",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
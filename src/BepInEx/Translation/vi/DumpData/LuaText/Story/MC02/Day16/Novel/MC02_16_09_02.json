{
  "Script": "Story/MC02/Day16/Novel/MC02_16_09_02",
  "Entries": [
    {
      "Key": "VC_MC02_18_09_01_Novel_00000_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Alright, let's try that new song all the way to the end.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00001_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's too fast.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00002_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No, we can do it!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00003_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yeah. Let's do this thing.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00004_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Look, all you're doing is making sound effects...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00005_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Let's go get 'em!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00006_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I'm fine with that plan.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00007_EAoi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I'll try my best!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00008_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We don't have any lyrics, though...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00009_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You can just make a word salad.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00010_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "A word...salad?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00011_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Just slap some random words together while singing, and sometimes it starts feeling right. You can use that later to flesh out the actual lyrics and whatnot.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00012_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I'll try...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00013_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okay, Yukkie, let's get started!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00014_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00015_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "A little more. One more time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00016_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00017_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We're not quite there yet, one more time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00018_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00019_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Let's match the sounds a little better! One more time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00020_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00021_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We're almost there! One more time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00022_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00023_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Mmm, this is really close! One more time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00024_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00025_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Let's match the sounds a little better! One more time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00026_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_Z_900600076_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Wait! We're just going in circles now!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00027_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Huh?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00028_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You started saying the same thing. I was starting to fear that it was going to go on forever...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00029_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "But we really are close to getting it.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00030_EAoi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yes. We've already come this far, so let's keep going!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00031_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I'm totally in fer that!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00032_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You've got it easy, I swear...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00033_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Alright, this is the last one. One, two!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00034_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It worked...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00035_EAoi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We made it...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00036_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Wow...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00037_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Ohh, perfect!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00038_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We did it!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00039_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Phew...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00040_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "Real nice song we got 'ere. This is a gonna be a best seller for sure.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_18_09_01_Novel_00041_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You're the only one here looking at it from a producer's perspective...",
      "Vietnamese": ""

    {
      "Key": "VC_MC02_07_06_00_Novel_00001_STezuka",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yesterday, you successfully secured one-third of the route leading to Point Gamma.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_00445_v001_STezuka",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Which means today's objective is to complete the next third of the route.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_07_06_00_Novel_00003_STezuka",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yesterday's objective was to secure a third of the route leading to Point Gamma.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_00446_v001_STezuka",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Today's objective is to finish securing two-thirds of the route, including what you didn't complete yesterday.",
      "Vietnamese": ""
    },
    {

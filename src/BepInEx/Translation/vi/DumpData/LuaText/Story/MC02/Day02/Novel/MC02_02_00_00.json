{
  "Script": "Story/MC02/Day02/Novel/MC02_02_00_00",
  "Entries": [
    {
      "Key": "VC_MC02_02_00_00_Novel_00000_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Hey, Yukkie. Know what day it is today?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00001_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Huh? Is it a special day today?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00002_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Whaaat? You don't remember?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00003_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Don't tell me...is it your birthday?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00004_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Nope!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00005_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then what is it?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00006_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The answer is...",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.doubleQuestion:0",
      "Original": "What day is it today?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.doubleQuestion:1",
      "Original": "Our once-a-week...|The Cancer's...|The everyone-but-Yukkie...",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.doubleQuestion:2",
      "Original": "day off!|Obon dance day!|explosion day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00013_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Our once-a-week day off!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00014_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Let me fill you in on something. That's called Sunday.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00015_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I may have heard of that!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00016_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We may be exempt from training, but if anything happens, we'll be deployed.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00017_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then it's not really a day off, is it?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00018_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "This is the era we were born into. Just accept it.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00019_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Our once-a-week Obon dance day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00020_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You want us to put on a festival every week?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00021_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's fiiine. It's just once a week.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00022_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Once a year is plenty, thank you.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00023_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Our once-a-week explosion day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00024_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "What exactly is going to explode?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00025_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You are.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00026_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That would kill me.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00027_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I didn't think that far ahead...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00028_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "So how about we blow this place and have some fun?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00029_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's Sunday. Let me rest for once...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00030_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The Cancer's day off!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00031_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Sounds like we should launch an all-out attack and wipe them out once and for all.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00032_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You're right! This is our chance!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00033_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Sorry to break it to you, but the Cancer do not take days off.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00034_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Seriously?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00035_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The Cancer's Obon dance day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00036_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Incredible. They'll be super distracted. Perfect opportunity for an all-out attack.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00032_RKayamori#2",
      "Context": "Adv.talkWithFacial:3",
      "Original": "You're right! This is our chance!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00038_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Now tell me, do you think such a day actually exists?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00039_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Guess not, huh?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00040_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The Cancer's explosion day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00041_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Sweet. Then humanity wins. We did it.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00042_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "But that would just be too easy, wouldn't it? Anyways, Yukkie, what're you up to today?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00043_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I go out of my way to play along with your nonsense, and that's all I get?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00044_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The everyone-but-Yukkie day off!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00045_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I deserve some rest too!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00046_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yukkie, you're smart, so you don't need to rest.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00047_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That doesn't make any sense. If anything, I should need to rest more.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00048_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then you want to join us?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00049_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Obviously. Was that ever in question?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00050_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The everyone-but-Yukkie Obon dance day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00051_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That was close. Glad I'm not part of this.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00052_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "But dancing's great! C'mon, dance with me!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00053_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00054_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Okay, then I'll make today a \"Yukkie dances too\" day.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00055_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Since when do you dictate my life? Give me <i>one</i> day off.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00056_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "The everyone-but-Yukkie explodes day!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00057_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Then I'd be the only one left on the planet. How cruel.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00058_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Didn't know you got lonely that easily. It's all right, I'll always be with you!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00059_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "That's a bit much. You say that like we're getting married.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00060_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We just woke up and they're flirtin' already?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00061_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's their morning ritual at this point!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00062_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We are <i>not</i> flirting!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00063_STezuka",
      "Context": "Adv.bubble_SPEAKER:1",
      "Original": "Seraph Squad 31-A, report to your classroom immediately!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00064_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Another sudden summons.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00065_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "What could it be?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00066_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I've got a good feeling about this. Let's go.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_02_00_00_Novel_00067_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "As always, I admire your optimism...",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
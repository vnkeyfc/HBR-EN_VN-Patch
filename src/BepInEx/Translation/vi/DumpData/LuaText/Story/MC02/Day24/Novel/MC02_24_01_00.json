    },
    {
      "Key": "VC_MC02_24_01_00_Novel_00001_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Yup.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_01_00_Novel_00002_STezuka",
      "Context": "Adv.showMiniCutIn:2",
      "Original": "This is as far as the helicopter can go. Everything beyond this point is a buffer zone between you and the enemy.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_01_00_Novel_00003_STezuka",
      "Context": "Adv.miniCutIn:2",
      "Original": "You'll need to proceed on foot.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_24_01_00_Novel_00004_STezuka",
      "Context": "Adv.showMiniCutIn:2",
      "Original": "The operation will commence in two minutes.",

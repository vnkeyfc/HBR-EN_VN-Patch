    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00018_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "So, what's going on here?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00019_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We were just talking about how this cheese naan is super delicious.",

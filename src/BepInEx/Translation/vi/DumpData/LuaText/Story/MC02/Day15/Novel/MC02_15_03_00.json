    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00003_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Oh, hey. You seem to be doing well.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00004_YBungo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Who dares approach, <i>snip</i>?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00005_BIYamawaki",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Are you here to bother us?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00006_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Nah, I was just thinking we're all in the same boat.",

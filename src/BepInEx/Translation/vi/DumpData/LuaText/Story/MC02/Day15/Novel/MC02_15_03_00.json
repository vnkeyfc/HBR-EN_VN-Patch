    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00022_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Awww, c'mon...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00023_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Whatever, I'm gonna chow down on some naan too!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00024_YBungo",
      "Context": "Adv.talk:1",
      "Original": "That's crazy! Did you see how she switched her mood so quickly, <i>snip</i>?!",
      "Vietnamese": ""

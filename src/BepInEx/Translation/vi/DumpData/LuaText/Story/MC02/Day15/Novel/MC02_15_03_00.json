    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00009_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I never said anything about dumbness.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00010_BIYamawaki",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I think anyone put in the same category as you is going to think they're being called stupid.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00011_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Oof, ouchie...my feelings. Girls, help me out here!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00012_KAsakura",
      "Context": "Adv.talkWithFacial:3",
      "Original": "What is this...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00013_TTojo",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Amazing! Look at all that cheese!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00014_TKunimi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "If you put honey on it, it's practically a dessert!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00015_MAikawa",
      "Context": "Adv.talkWithFacial:3",
      "Original": "It's a proper meal and a sweet treat at the same time!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00016_RKayamori",
      "Context": "Adv.playCutIn:3",
      "Original": "They're having fun all on their own!!!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_15_03_00_Novel_00017_BIYamawaki",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Vhat a pitiful fool.",

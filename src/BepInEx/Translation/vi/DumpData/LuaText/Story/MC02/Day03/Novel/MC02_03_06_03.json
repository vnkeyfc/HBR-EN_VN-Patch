  "Entries": [
    {
      "Key": "VC_MC02_03_06_03_Novel_00000_NNanase",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Well done today. Your clear time and amount of secured territory met expectations. Keep up the good work.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_03_06_03_Novel_00001_NNanase",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Training concluded. Your clear time was well over the set limit.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_03_06_03_Novel_00002_NNanase",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Your capabilities as a squad are inadequate. Please train further and return when you are ready.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_03_06_03_Novel_00003_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "No waaay!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC02_03_06_03_Novel_00004_YIzumi",
      "Context": "Adv.talkWithFacial:3",
      "Original": "I more or less expected that, given our current state.",

    },
    {
      "Key": "VC_MC02_03_06_03_Novel_00005_RKayamori",
      "Context": "Adv.talkWithFacial:3",
      "Original": "We've gotta be able to blast through these training exercises if we wanna have any hope of becoming legends!",
      "Vietnamese": ""

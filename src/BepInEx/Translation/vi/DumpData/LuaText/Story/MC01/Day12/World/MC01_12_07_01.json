    {
      "Key": "VC_MC01_12_07_01_World_00005_TTojo",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Roger!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_07_01_World_00006_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Now they're stuck down here with us! We're up, Cappy!",

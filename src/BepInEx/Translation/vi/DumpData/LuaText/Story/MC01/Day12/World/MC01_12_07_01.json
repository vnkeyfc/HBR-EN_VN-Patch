    },
    {
      "Key": "VC_MC01_12_07_01_World_00003_MAikawa",
      "Context": "Adv.talkWithIcon:1",
      "Original": "This ain't no time to chicken out.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_07_01_World_00004_YIzumi",
      "Context": "Adv.talkWithIcon:1",
      "Original": "First, let's take a shot at that wall. Timing is everything here, Intel Agent!",

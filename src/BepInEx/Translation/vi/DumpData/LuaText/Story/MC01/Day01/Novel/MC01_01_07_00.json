{
  "Script": "Story/MC01/Day01/Novel/MC01_01_07_00",
  "Entries": [
    {
      "Key": "VC_MC01_01_07_00_Novel_00000_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Easy-peasy!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00001_TTojo",
      "Context": "Adv.talk:1",
      "Original": "Amazing... To think we can wield such power...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00002_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "With this, I can wipe 'em out myself.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00003_TKunimi",
      "Context": "Adv.talk:1",
      "Original": "Saving humanity's going to be a piece of cake!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00004_NNanase",
      "Context": "Adv.talk:1",
      "Original": "That was also a systems test. The enemies were on the weakest setting.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00005_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "So they'll only get stronger from here on out?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00006_NNanase",
      "Context": "Adv.talk:1",
      "Original": "Correct. Further training sessions will have stronger, sturdier Cancers in droves.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00007_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Aw, maaan...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00008_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "Sounds like she's sayin' the world ain't gonna be easy as pie...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00009_TTojo",
      "Context": "Adv.talk:1",
      "Original": "Guess not...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_07_00_Novel_00010_TKunimi",
      "Context": "Adv.talk:1",
      "Original": "Saving humanity's going to be harder than I thought!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00115_v002_STezuka",
      "Context": "Adv.talk:1",
      "Original": "If it was easy, humanity wouldn't have been pushed to the brink.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00116_v002_STezuka",
      "Context": "Adv.talk:1",
      "Original": "We are the Seraph Squadron, the last bastion of mankind. Should we fall, humanity will fall with us.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00117_v002_STezuka",
      "Context": "Adv.talk:1",
      "Original": "On that note, we will continue today's training.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00118_v002_NNanase",
      "Context": "Adv.talk:1",
      "Original": "Your next enemies will be significantly stronger than the previous one.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00119_v002_NNanase",
      "Context": "Adv.talk:1",
      "Original": "With higher defenses comes higher durability, as well as the risk of counterattacks.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00120_v002_NNanase",
      "Context": "Adv.talk:1",
      "Original": "And with higher attack power comes the possibility of being taken out in a single hit.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00121_v002_NNanase",
      "Context": "Adv.talk:1",
      "Original": "Remember the tools at your disposal: not only direct attacks, but also buffs, debuffs, and healing.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00122_v002_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Roger that.",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
{
  "Script": "Story/MC01/Day10/World/MC01_10_08_00",
  "Entries": [
    {
      "Key": "VC_MC01_10_09_00_World_00000_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(That's...)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00001_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Master, Master! They're selling corn dogs, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00002_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Yes? Vhat of it?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00003_YBungo",
      "Context": "Adv.talk:1",
      "Original": "I want one, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00004_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "That kind of junk is for peace-loving peasants! Vee world-destroyers only eat ze finest morsels!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00005_YBungo",
      "Context": "Adv.talk:1",
      "Original": "So, Master, if I eat this, I'll join the peasants and be destroyed, <i>snip</i>?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00006_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "But vell, let’s see...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00007_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "I'll let you have one if you promise to do vhat I'm about to say.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00008_YBungo",
      "Context": "Adv.talk:1",
      "Original": "I'm your trusty lackey, Master! Of course I'll do it, <i>snip</i>! So, what is your wish, Master?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00009_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Well...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00010_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Uhh...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00011_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "I need you to prepare for the day when you will no longer be my familiar.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00012_YBungo",
      "Context": "Adv.talk:1",
      "Original": "But why, Master? Why would you say such a sad thing, <i>snip</i>?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00013_YBungo",
      "Context": "Adv.talk:1",
      "Original": "I'll always be your trusty familiar, Master! Until the very end, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00014_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "If zat's so, zhen no corn dog for you today. Better luck next time.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00015_YBungo",
      "Context": "Adv.talk:1",
      "Original": "But why?! Why do I have to prepare for such a crazy thing, <i>snip</i>?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00016_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Nngh...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00017_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Heh... I was just kidding. Don't take it so seriously.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00018_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Ughhh! You scared me, Master!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00019_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "It's ze exact opposite. You'll always be my familiar.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00020_YBungo",
      "Context": "Adv.talk:1",
      "Original": "I wouldn't have it any other way, Master, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00021_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "One peasant corn dog, please!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00022_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Here, your precious corn dog. You'd better eat up so you don't drop it!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00023_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Hooray, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00024_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Any mustard or ketchup?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00025_YBungo",
      "Context": "Adv.talk:1",
      "Original": "I want some, <i>snip</i>! But my hand's already full! What do I do, <i>snip</i>?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00026_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "You leave me no choice. I shall deign to squeeze it for you. How much?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00027_YBungo",
      "Context": "Adv.talk:1",
      "Original": "As much as you can fit on there, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00028_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "You should at least go easy on ze mustard. It's really strong!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00029_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Good point, Master! Then less mustard, more ketchup, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00030_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Mmm-<i>mmm</i>! Corn dogs are the best, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00031_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Good thing vee got you one, zen!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_10_09_00_World_00032_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "(Is it just me, or Wakkie had a kind of conflicted look on her face...?)",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
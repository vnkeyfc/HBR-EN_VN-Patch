{
  "Script": "Story/MC01/Day06/Novel/MC01_06_10_01",
  "Entries": [
    {
      "Key": "VC_MC01_06_10_01_Novel_00000_TKunimi",
      "Context": "Adv.talk:1",
      "Original": "Hrrrnnngggh.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00001_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "What is it, Cappy?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00002_TKunimi",
      "Context": "Adv.talk:1",
      "Original": "My sound isn't as big as the original's.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00003_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Thinking about these things already? Your progress is off the charts, Cappy!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00004_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "Just the other day, you said you couldn't reckon what a bass sounds like.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00005_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Actually, the picks we have here aren't suited for the bass.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00006_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "Aren't all picks the same, give or take?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00007_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Nope. The ones we've been using are all thin picks.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00008_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "I was just thinkin' a slightly thicker pick would be better.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00009_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Then let's see if we can find a medium one.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00010_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "If we don't already have one here, where are we supposed to find one?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00011_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Sometimes you just find 'em on the ground, you know?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_10_01_Novel_00012_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "What, like spare change?",
      "Vietnamese": ""
    }
  ],

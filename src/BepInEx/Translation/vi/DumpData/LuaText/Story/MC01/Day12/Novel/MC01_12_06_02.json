{
  "Script": "Story/MC01/Day12/Novel/MC01_12_06_02",
  "Entries": [
    {
      "Key": "VC_MC01_12_06_02_Novel_00000_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Mm...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00001_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "What's wrong? Why the long face? Are you scared?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00002_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Of course I'm scared. Our lives are on the line.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00003_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "I'm starting to wonder why we're even doing this to begin with.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00004_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Have faith. This is all for the sake of humanity, including ourselves.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00005_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "How am I supposed to have faith in anything? Humans aren't all sunshine and rainbows, either...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00006_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Fine. Then just this once, have faith in me.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00007_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "In you?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00008_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Yeah. I believe anything that indiscriminately takes human life is evil. So trust me, and let that be your guide.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00009_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Heh. If that's your take on it, then I guess I gotta follow your lead.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00010_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "But...just forget I said all that after this is done. That was so cringey, I could die.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00011_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Hell no. I'll remember this forever.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00012_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "So, what? Should we get married after this battle is over?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00013_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Ha, what's that all about?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00014_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Is that a \"no\"?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_12_06_02_Novel_00015_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "No way. I couldn't be happier!",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
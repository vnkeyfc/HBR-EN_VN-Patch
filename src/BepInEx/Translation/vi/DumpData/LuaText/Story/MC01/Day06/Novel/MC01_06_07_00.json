      "Context": "Adv.bubbleAngerAsync:1",
      "Original": "H'all righty!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_07_00_Novel_00021_TKunimi",
      "Context": "Adv.bubbleAngerAsync:1",
      "Original": "Aye!!!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_06_07_00_Novel_00022_YIzumi",

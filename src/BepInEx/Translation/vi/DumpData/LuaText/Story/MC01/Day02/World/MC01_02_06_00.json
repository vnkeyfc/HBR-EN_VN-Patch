{
  "Script": "Story/MC01/Day02/World/MC01_02_06_00",
  "Entries": [
    {
      "Key": "VC_MC01_02_06_00_World_00000_RKayamori",
      "Context": "Field.returnToWayPoint:2",
      "Original": "Oh no, Yukkie was right! I've hit my rebellious phase! No time for that.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00001_RKayamori",
      "Context": "Field.returnToWayPoint:2",
      "Original": "Oh no, I'm turning into a staircase junkie! No time for that.",
      "Vietnamese": ""
    },
    {
      "Context": "SetPeriodText:0",
      "Original": "Head to the arena!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00002_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "More training today, huh?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00003_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "Better get to the arena.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00004_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "I wonder how they'll put us through the wringer today.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00005_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Knowing that commander of ours, I bet she's gonna turn the difficulty all the way.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00006_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Let's show her we're not pushovers.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00007_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "You're with me on this, right Tojo?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00008_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "We need to go into this as prepared as possible.",
      "Vietnamese": ""
    },
    {
      "Context": "Tutorial.setMessage:0",
      "Original": "Today's training will be with Squad 31-A only.\\nIf you have stronger Memoria, try adding them to your squad now.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00009_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "Can't afford to lose today...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00010_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "I'll show 'em who's boss, psychic style!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00011_TTojo",
      "Context": "Adv.talk:1",
      "Original": "The arena was...where, again?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00012_TTojo",
      "Context": "Adv.talk:1",
      "Original": "Ruka, do you know?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:0",
      "Original": "Which way to the arena?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:1",
      "Original": "Left|Right",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00013_TTojo",
      "Context": "Adv.talk:1",
      "Original": "I'm absolutely stumped. Can I join you?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00013_TTojo#2",
      "Context": "Adv.talk:1",
      "Original": "I'm absolutely stumped. Can I join you?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00016_TKunimi",
      "Context": "Field.talkByGayaBalloon:1",
      "Original": "I'm starting to get used to these vending machines...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00017_TKunimi",
      "Context": "Field.talkByGayaBalloon:1",
      "Original": "Or so I thought! Only water and tea?!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00018_TKunimi",
      "Context": "Field.talkByGayaBalloon:1",
      "Original": "Well played, vending machine!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00019_TKunimi",
      "Context": "Field.talkByGayaBalloon:1",
      "Original": "So many buttons, but only two options!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00020_TKunimi",
      "Context": "Field.talkByGayaBalloon:1",
      "Original": "I have to get to the arena! But...I want to press the buttons!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_06_00_World_00021_TKunimi",
      "Context": "Field.talkByGayaBalloon:1",
      "Original": "What a tease, only water and tea!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_03_06_00_World_00005_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "If you're all set, let's go.",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
    {
      "Key": "VC_MC01_02_03_00_Novel_00000_STezuka",
      "Context": "Adv.talk:1",
      "Original": "In combat, survival is not only a matter of physical strength. It is also a matter of wits.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00001_STezuka",
      "Context": "Adv.talk:1",
      "Original": "As such, you will be taking a proficiency test to measure your academic capabilities.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00002_STezuka",
      "Context": "Adv.talk:1",
      "Original": "First up: composition. After each battle, you will be required to submit a report. Clear, succinct writing is a must.",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:0",
      "Original": "A proficiency test?",
      "Vietnamese": ""
    },
    {
      "Context": "Adv.question:1",
      "Original": "Boo|Understood!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00003_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Whaaa? Boo, boooo!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00004_STezuka",
      "Context": "Adv.talk:1",
      "Original": "Booing is typically a group effort.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00005_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Join me, Yukkie! Boo, boooo!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_04_03_00_Novel_00039_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Leave me out of this.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00007_STezuka",
      "Context": "Adv.talk:1",
      "Original": "Further instruction will be given regarding these reports, but for now, we must assess your current level.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00008_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Nooo! Screw this! It's all gibberish!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_02_03_00_Novel_00009_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Understood!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_00002_v005_STezuka",
      "Context": "Adv.talk:1",
      "Original": "Well, you're rather cooperative today.",
      "Vietnamese": ""
    },

    {
      "Key": "VC_MC01_01_06_01_Novel_00141_NNanase",
      "Context": "Adv.talk:1",
      "Original": "Simply hold up your mePad and recite your Seraph Code to summon your Seraph weapon.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_06_01_Novel_00142_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Can I just summon it whenever I want?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_06_01_Novel_00143_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "For what?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_01_06_01_Novel_00144_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Like when my back's itchy.",

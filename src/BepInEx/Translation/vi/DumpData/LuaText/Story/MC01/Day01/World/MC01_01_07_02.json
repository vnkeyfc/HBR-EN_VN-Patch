    {
      "Context": "Tutorial.setMessage:0",
      "Original": "You can upgrade Memorias from here. Try doing so now.",
      "Vietnamese": ""
    },
    {
      "Context": "Tutorial.setMessage:0",
      "Original": "Each upgrade will progress along a tree. Let's have a peek.",
      "Vietnamese": ""

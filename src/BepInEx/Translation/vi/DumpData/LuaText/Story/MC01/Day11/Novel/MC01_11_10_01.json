{
  "Script": "Story/MC01/Day11/Novel/MC01_11_10_01",
  "Entries": [
    {
      "Key": "VC_MC01_11_09_01_Novel_00000_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "I bet you're thinking, \"Damn, it's been too long since I made music!\"",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00001_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "I've never thought that once in my life.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00002_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Let's hit the studio!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00003_KAsakura",
      "Context": "Adv.talk:1",
      "Original": "Everyone got really good right away, but I'm still not up to snuff...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00004_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Don't sweat it! Everyone screws up their first gig.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00005_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Wait. Since when were we having a gig?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00006_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Since now.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00007_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Yeah, right!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00008_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Why the heck not?! There's no better feeling than lifting people's spirits with music. I want you all to get a taste of that.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00009_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Why on earth do we need to do something like that?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00010_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "To remember how good it feels to be alive.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00011_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Mm...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00012_TKunimi",
      "Context": "Adv.talk:1",
      "Original": "Jam city, here we come!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00013_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "I mean, I ain't opposed.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00014_TTojo",
      "Context": "Adv.talk:1",
      "Original": "Then I'll do my best to support everyone on keyboard.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00015_Karen",
      "Context": "Adv.talk:1",
      "Original": "IIIT'S SHOWTIME!!! BODODODODODUOH!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00016_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "You've got the genre all wrong.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00017_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "We'll take over a corner of the cafeteria and turn it into a swanky jazz bar!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_09_01_Novel_00018_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Weren't we supposed to be a rock band?",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
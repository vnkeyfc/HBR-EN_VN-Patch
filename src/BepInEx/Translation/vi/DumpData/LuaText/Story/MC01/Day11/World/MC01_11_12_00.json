{
  "Script": "Story/MC01/Day11/World/MC01_11_12_00",
  "Entries": [
    {
      "Key": "VC_MC01_11_11_00_World_00000_RKayamori",
      "Context": "Field.returnToWayPoint:2",
      "Original": "What's happening by the entrance?",
      "Vietnamese": ""
    },
    {
      "Context": "SetPeriodText:0",
      "Original": "Wait for Yamawaki!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00001_RKayamori",
      "Context": "Field.returnToWayPoint:2",
      "Original": "I'll head that way another time.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00002_RKayamori",
      "Context": "Field.returnToWayPoint:2",
      "Original": "Better see where she's going.",
      "Vietnamese": ""
    },
    {
      "Context": "SetPeriodText:0",
      "Original": "Find 31-C!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00003_RKayamori",
      "Context": "Field.returnToWayPoint:2",
      "Original": "They were around those vending machines, right?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00004_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Wonder if they're meeting up again tonight.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00005_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(There's Merry. Looks like Wakkie isn't here yet.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00006_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(I'll go hide down the hall for now.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00007_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Right around here should work.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00008_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(That must've been her!)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00009_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Agent Ruka, out.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00010_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(They're headed to Main Street again. Better follow suit.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00011_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(Are they by the vending machines again? Only one way to find out.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00012_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(It's starting.)",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00013_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Are we all here?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00014_MSatsuki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Yup.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00015_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Great news, everyone. I've really outdone myself this time.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00016_AKanzaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "How so?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00017_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Even with the world like this, we're still a proper military force.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00018_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "That means we'll be compensated with rank and merit for our efforts!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00019_SSakuraba",
      "Context": "Adv.talkWithIcon:1",
      "Original": "...That is quite a stretch, don't you think?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00020_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "In the past, in exchange for meritorious deeds, the family members of the enlisted were able to receive access to quality medical care.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00021_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "So, by distinguishing ourselves in combat, we should be able to request advanced medical care as a reward!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00022_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "I'm planning on negotiating with the commander once I've earned my stripes in the next operation.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00023_MSatsuki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "I see...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00024_AKanzaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "But will that really work?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00025_MTenne",
      "Context": "Adv.talkWithIcon:1",
      "Original": "I am highly skeptical.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00026_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Come on, just trust me! It WILL work! It MUST!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_Z900000032_MSatsuki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "How about using our portion of the rewards too, Ivar?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00028_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "I couldn't ask that of you.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00029_AKanzaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "You needn't stand on ceremony.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00030_MSatsuki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "You said it. ♪",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00031_SSakuraba",
      "Context": "Adv.talkWithIcon:1",
      "Original": "...I have to concur.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00032_MTenne",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Not me. I require a research room for my studies.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00033_AKanzaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Tenne-dono's values are truly unwavering.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00034_MTenne",
      "Context": "Adv.talkWithIcon:1",
      "Original": "However...I will relent just this once. Feel free to use my reward.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00035_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Thank you, all of you...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00036_MSatsuki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Right. Let's show them who really deserves that \"A\"! ♪",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00037_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Thank you...",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00038_BIYamawaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "You may not be rewarded in the next operation, but you will win my undying gratitude!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00039_MSatsuki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Sure! ♪",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00040_AKanzaki",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Ja!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00041_SSakuraba",
      "Context": "Adv.talkWithIcon:1",
      "Original": "...Okay.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00042_MTenne",
      "Context": "Adv.talkWithIcon:1",
      "Original": "Indeed.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_11_00_World_00043_RKayamori",
      "Context": "Adv.kayamoriTalk:0",
      "Original": "(I don't really get what's happening, but they seem more unified than ever.)",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
{
  "Script": "Story/MC01/Day11/Novel/MC01_11_01_00",
  "Entries": [
    {
      "Key": "VC_MC01_11_01_00_Novel_00000_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "Alright, time for breakfast!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00001_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "We know. You don’t have to announce it.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00002_RKayamori",
      "Context": "Adv.talk:1",
      "Original": "But announcing it boosts morale.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00003_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Killing the Cancer already accomplishes that. At least give us <i>some</i> down time.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00004_MAikawa",
      "Context": "Adv.talk:1",
      "Original": "Hold up. There’s 31-C again.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00005_TKunimi",
      "Context": "Adv.talk:1",
      "Original": "A head-to-head!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00006_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Heh...peasants. You think you can afford to eat breakfast, when you’re already eating our musk!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00007_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "It's \"eat our dust,\" not \"eat our musk.\"",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00008_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "I had no idea!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00009_YBungo",
      "Context": "Adv.talk:1",
      "Original": "The Great Yamawaki isn't very smart, <i>snip</i>!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00010_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Should a lackey really be saying that?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00011_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Don't you know the Great Yamawaki is a brilliant mad scientist, <i>snip</i>?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00012_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "That sensation you're feeling right now is...pet loss syndrome.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00013_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "I've never raised a pet in my life. You mean \"déjà vu.\"",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00014_YBungo",
      "Context": "Adv.talk:1",
      "Original": "Oh...she's good, <i>snip</i>.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00015_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "How do I always wind up getting pulled into this utter nonsense?",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00016_BIYamawaki",
      "Context": "Adv.talk:1",
      "Original": "Okay then, stupid dust-eaters. You have fun now. We're leaving, Minion!",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00017_YBungo",
      "Context": "Adv.talk:1",
      "Original": "But I'm starving, Master! <i>snip, snip</i>",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00018_TTojo",
      "Context": "Adv.talk:1",
      "Original": "They seem to be way ahead of us, from the way they're talking.",
      "Vietnamese": ""
    },
    {
      "Key": "VC_MC01_11_01_00_Novel_00019_YIzumi",
      "Context": "Adv.talk:1",
      "Original": "Guess so.",
      "Vietnamese": ""
    }
  ],
  "Inserts": []
}
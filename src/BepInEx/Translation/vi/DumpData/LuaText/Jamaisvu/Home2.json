    {
      "Key": "VC_ActivityAtArena_00001_v003_NNanase",
      "Context": "Adv.talk:1",
      "Original": "Hello, Cadet Kayamori.",
      "Vietnamese": "Xin chào, Kayamori-san."
    },
    {
      "Key": "VC_ActivityAtArena_00004_NNanase",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Did you come here to train today?",
      "Vietnamese": "Cô đến đây để huấn luyện sao?"
    },
    {
      "Key": "VC_ActivityAtArena_00009_v003_NNanase",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Please wait a moment while I boot up the system.",
      "Vietnamese": "Tôi đang chuẩn bị khởi động hệ thống, xin vui lòng đợi một lát."
    },
    {
      "Key": "VC_ActivityAtArena_00026_RKayamori",
      "Context": "Adv.playCutIn:3",
      "Original": "Okay, let's rock!!!",
      "Vietnamese": "Quẩy thôi!!"
    },
    {
      "Key": "VC_ActivityAtArena_00012_v003_NNanase",
      "Context": "Adv.talkWithFacial:3",
      "Original": "Thank you all for your hard work.",
      "Vietnamese": "Mọi người vất vả rồi."
    },
    {
      "Key": "VC_Z_900400088_MSatsuki",
      "Context": "Adv.talk:1",
      "Original": "Welcome! With our products, you get what you pay for! ♪",
      "Vietnamese": "Kính chào quý khách!! Đồ ở shop toàn là hàng \"tiền nào của nấy\", đảm bảo công hiệu luôn ♪"
    },
    {
      "Context": "UI.shop:1",
      "Original": "Everything here is highly recommended! ♪",
      "Vietnamese": "Tất cả đều rất đáng để mua đó! ♪"
    },
    {
      "Key": "VC_Z_900400091_MSatsuki",
      "Context": "Adv.talk:1",
      "Original": "Hope you get what you paid for! ♪ Keep raking in more GP to spend here! ♪",
      "Vietnamese": "Có đúng là \"tiền nào của nấy\" không ạ? ♪ Quý khách nhớ đi cày cho thật nhiều GP rồi vác mặt về đây tiếp nhé ♪"
